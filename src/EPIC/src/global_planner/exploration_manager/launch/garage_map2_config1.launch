<launch>
  <!-- Combo 3/4:  map2 = poongsan_garage  x  config1 = 360deg LiDAR (original)
       roslaunch epic_planner garage_map2_config1.launch -->

  <!-- ======== SET THIS LAUNCH'S DRONE START POSE HERE ========
       poongsan_garage is a dense map — use the full_map (global_cloud) RViz
       display to pick free space. Editable in-file, or override on the CLI:
         roslaunch epic_planner garage_map2_config1.launch init_x:=10 init_y:=5 init_z:=2 -->
  <arg name="init_x"   default="5.0" />
  <arg name="init_y"   default="0.0" />
  <arg name="init_z"   default="2.0" />
  <arg name="init_yaw" default="0.0" />
  <!-- ========================================================= -->

  <include file="$(find epic_planner)/launch/garage_base.launch">
    <arg name="map_name" value="poongsan_garage" />
    <arg name="config_file" value="poongsan_garage.yaml" />
    <!-- config1: original 360deg tilted LiDAR -->
    <arg name="lidar_yaw_fov" value="360.0" />
    <arg name="lidar_vertical_fov" value="90.0" />
    <arg name="lidar_is_360" value="1" />
    <arg name="lidar_pitch" value="40.0" />
    <!-- map2 eval bounds (poongsan_garage extent, floor z~=0) -->
    <arg name="eval_map_min_x" value="-2.0" />
    <arg name="eval_map_min_y" value="-11.0" />
    <arg name="eval_map_min_z" value="-0.2" />
    <arg name="eval_map_max_x" value="40.0" />
    <arg name="eval_map_max_y" value="20.0" />
    <arg name="eval_map_max_z" value="3.8" />
    <arg name="init_x" value="$(arg init_x)" />
    <arg name="init_y" value="$(arg init_y)" />
    <arg name="init_z" value="$(arg init_z)" />
    <arg name="init_yaw" value="$(arg init_yaw)" />
  </include>
</launch>
